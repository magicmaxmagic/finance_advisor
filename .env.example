# Copy to .env and edit. All settings are prefixed FINLAB_.

# --- paths -------------------------------------------------------------------
# Root of the data tree. Subdirectories (raw, staging, warehouse, db, reports,
# mlruns) are created underneath it on `finlab db init`.
FINLAB_DATA_DIR=./data

# --- SEC ---------------------------------------------------------------------
# REQUIRED. SEC rejects requests without a real contact address in User-Agent.
# Format: "Organisation Name contact@example.com"
FINLAB_SEC_USER_AGENT=finlab you@example.com
# Hard cap. SEC's published limit is 10 requests/second; do not raise this.
FINLAB_SEC_MAX_RPS=10
FINLAB_SEC_MAX_CONCURRENCY=8

# --- Ollama Cloud ------------------------------------------------------------
FINLAB_OLLAMA_BASE_URL=https://ollama.com
FINLAB_OLLAMA_API_KEY=
# Pro tier allows 3 concurrent models. Raising this yields 429s, not throughput.
FINLAB_OLLAMA_MAX_CONCURRENCY=3

# --- DuckDB ------------------------------------------------------------------
# 9 GB on a 16 GB host leaves room for the OS and the Python process.
FINLAB_DUCKDB_MEMORY_LIMIT=9GB
FINLAB_DUCKDB_THREADS=4

# --- logging -----------------------------------------------------------------
FINLAB_LOG_LEVEL=INFO
# json for the daemon, console for interactive use
FINLAB_LOG_FORMAT=console

# Marché en direct starts in an explicitly fictional offline demo.
FINLAB_MARKET_MODE=demo
# Set live to select the real source by default, then connect it in the UI.
# Use Alpaca paper API keys (calendar + read-only IEX data). No orders are submitted.
# Configure both keys in .env on the server; never commit or paste them into logs.
# Weekly briefs also use these keys. Unset keys disable the scheduled weekly job.
# FINLAB_ALPACA_KEY_ID=
# FINLAB_ALPACA_SECRET_KEY=

# Incremental Yahoo synchronization. Calendar-day overlap checks recent corrections.
FINLAB_PRICE_HISTORY_START=2006-01-01
FINLAB_PRICE_CORRECTION_OVERLAP_DAYS=10
# Optional YAML with companies: [{cik,ticker,sector,name,security_id?}, ...].
# Keep explicit security_id unchanged when renaming a ticker.
# FINLAB_UNIVERSE_PATH=/absolute/path/to/universe.yaml
# JSON weights must include all five families and sum to 1.
# FINLAB_FACTOR_WEIGHTS={"value":0.2,"quality":0.2,"growth":0.2,"momentum":0.2,"risk":0.2}
